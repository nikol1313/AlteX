{
  "manifest_version": 3,
  "name": "AlteX Student Portal",
  "version": "3.3.6",
  "description": "Visual redesign of the Alte University student portal.",
  "permissions": ["storage"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://students.alte.edu.ge/*"],
      "css": [
        "css/fonts.css",
        "css/base.css",
        "css/dashboard.css",
        "css/timetable.css",
        "css/applications.css",
        "css/learning-card.css",
        "css/finances.css",
        "css/registration.css",
        "css/programs.css",
        "css/chancellery.css",
        "css/assignments.css",
        "css/login.css"
      ],
      "js": [
        "js/core.js",
        "js/app.js",
        "js/academic-calendar.js",
        "js/dashboard.js",
        "js/nav.js",
        "js/timetable.js",
        "js/learning-card.js",
        "js/finances.js",
        "js/applications.js",
        "js/registration.js",
        "js/assignments.js",
        "js/login.js",
        "js/main.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": ["https://students.alte.edu.ge/*"]
    }
  ]
}
